{
  "expo": {
    "name": "me",
    "slug": "my-story-app",
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./mimi_clear_up.wav",
            "./mimi_clear.wav",
            "./mimi_down.wav",
            "./mimi_quick.wav",
            "./mimi_up.wav"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "채팅에 보낼 사진을 고르기 위해 사진 접근이 필요합니다.",
          "savePhotosPermission": "사진을 저장하려면 권한이 필요합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.anoldking.mystoryapp",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "6c901433-731c-4151-9e90-0efc0485d53d"
      }
    }
  }
}