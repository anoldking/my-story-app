{
  "expo": {
    "name": "Mestory",
    "slug": "my-story-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "android": {
      "package": "com.anoldking.mystoryapp",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#FEE500"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필과 스토리에 사진을 올리기 위해 갤러리 접근 권한이 필요합니다."
        }
      ]
    ]
  }
}
